<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yggdrasil.labs</groupId>
    <artifactId>mimir-boot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Mimir Boot</name>
    <description>Yggdrasil-Labs 的 Java 企业级基础框架，统一依赖版本、公共组件、自定义 Starter 与编译期代码生成工具</description>

    <modules>
        <module>mimir-boot-parent</module>
        <module>mimir-boot-bom</module>
        <module>mimir-boot-common</module>
        <module>mimir-boot-starters</module>
    </modules>

    <properties>
        <!-- 📌 版本号统一管理：只修改这里即可，所有子模块自动继承 -->
        <!-- 开发阶段使用 SNAPSHOT 版本，release-please 会在 Release PR 中自动处理 -->
        <revision>1.5.1-SNAPSHOT</revision>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <java.version>17</java.version>

        <!-- 项目信息 -->
        <project.name>Mimir Boot</project.name>
        <project.description>Yggdrasil-Labs 的 Java 企业级基础框架</project.description>
        <project.url>https://github.com/Yggdrasil-Labs/mimir-boot</project.url>
        <project.scm.url>https://github.com/Yggdrasil-Labs/mimir-boot.git</project.scm.url>
        <project.scm.connection>scm:git:git://github.com/Yggdrasil-Labs/mimir-boot.git</project.scm.connection>
        <project.scm.developerConnection>scm:git:ssh://github.com:Yggdrasil-Labs/mimir-boot.git
        </project.scm.developerConnection>

        <!-- 许可证 -->
        <project.license.name>Apache License, Version 2.0</project.license.name>
        <project.license.url>https://www.apache.org/licenses/LICENSE-2.0</project.license.url>

        <!-- Spotless 插件版本（用于根 POM 前缀解析与无源校验） -->
        <spotless.plugin.version>3.1.0</spotless.plugin.version>
        <!-- Flatten 插件版本 -->
        <flatten.plugin.version>1.7.3</flatten.plugin.version>
        <!-- SonarQube Maven 插件版本 -->
        <sonar-maven-plugin.version>5.5.0.6356</sonar-maven-plugin.version>
    </properties>

    <!-- 开发者信息 -->
    <developers>
        <developer>
            <id>yggdrasil-labs</id>
            <name>Yggdrasil Labs</name>
            <email>contact@yggdrasil-labs.com</email>
            <organization>Yggdrasil Labs</organization>
            <organizationUrl>https://yggdrasil-labs.com</organizationUrl>
        </developer>
    </developers>

    <!-- 许可证 -->
    <licenses>
        <license>
            <name>${project.license.name}</name>
            <url>${project.license.url}</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- SCM 信息 -->
    <scm>
        <connection>${project.scm.connection}</connection>
        <developerConnection>${project.scm.developerConnection}</developerConnection>
        <url>${project.scm.url}</url>
        <tag>HEAD</tag>
    </scm>

    <!-- 问题跟踪 -->
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Yggdrasil-Labs/mimir-boot/issues</url>
    </issueManagement>

    <!-- CI/CD -->
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/Yggdrasil-Labs/mimir-boot/actions</url>
    </ciManagement>

    <!-- 发布仓库配置 -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Yggdrasil-Labs/mimir-boot</url>
        </repository>
    </distributionManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten.plugin.version}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>oss</flattenMode>
                        <pomElements>
                            <dependencies>resolve</dependencies>
                            <dependencyManagement>resolve</dependencyManagement>
                        </pomElements>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- SonarQube Maven Plugin (代码质量分析) -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 在根模块声明一个"无源"的 Spotless，使 `spotless:*` 在根执行不报错 -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <includes>
                            <include>__NO_SOURCES__</include>
                        </includes>
                        <!-- 使用 Google AOSP 风格（完全符合阿里规范核心要求）
                             AOSP = Android Open Source Project
                             - 4 空格缩进（阿里规范）
                             - K&R 括号风格（阿里规范）
                             - 工具稳定、CI 友好
                        -->
                        <googleJavaFormat>
                            <version>1.22.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>
            <!-- Flatten Plugin (版本管理) - 确保所有模块都能正确替换 ${revision} -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <!-- SonarQube Maven Plugin (代码质量分析) - 使根模块也能识别 sonar 命令 -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
