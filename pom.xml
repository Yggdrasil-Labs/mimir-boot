<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.yggdrasil-labs</groupId>
    <artifactId>mimir-boot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Mimir Boot</name>
    <description>Yggdrasil-Labs 的 Java 企业级基础框架，统一依赖版本、公共组件、自定义 Starter 与编译期代码生成工具</description>
    <url>${project.url}</url>

    <modules>
        <module>mimir-boot-parent</module>
        <module>mimir-boot-bom</module>
        <module>mimir-boot-common</module>
        <module>mimir-boot-starters</module>
    </modules>

    <properties>
        <!-- 📌 版本号统一管理：只修改这里即可，所有子模块自动继承 -->
        <!-- 开发阶段使用 SNAPSHOT 版本，release-please 会在 Release PR 中自动处理 -->
        <revision>2.0.5-SNAPSHOT</revision>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <java.version>17</java.version>

        <!-- 项目信息 -->
        <project.name>Mimir Boot</project.name>
        <project.description>Yggdrasil-Labs 的 Java 企业级基础框架</project.description>
        <project.url>https://github.com/Yggdrasil-Labs/mimir-boot</project.url>
        <project.scm.url>https://github.com/Yggdrasil-Labs/mimir-boot.git</project.scm.url>
        <project.scm.connection>scm:git:git://github.com/Yggdrasil-Labs/mimir-boot.git</project.scm.connection>
        <project.scm.developerConnection>scm:git:ssh://github.com:Yggdrasil-Labs/mimir-boot.git</project.scm.developerConnection>

        <!-- 许可证 -->
        <project.license.name>Apache License, Version 2.0</project.license.name>
        <project.license.url>https://www.apache.org/licenses/LICENSE-2.0</project.license.url>

        <!-- Spotless 插件版本（用于根 POM 前缀解析与无源校验） -->
        <spotless.plugin.version>3.4.0</spotless.plugin.version>
        <!-- Flatten 插件版本 -->
        <flatten.plugin.version>1.7.3</flatten.plugin.version>
        <!-- SonarQube Maven 插件版本 -->
        <sonar-maven-plugin.version>5.5.0.6356</sonar-maven-plugin.version>
        <!-- Central Publishing Maven Plugin 版本（使用官方 org.sonatype.central 版本） -->
        <central-publishing-maven-plugin.version>0.10.0</central-publishing-maven-plugin.version>
        <!-- GPG Maven Plugin 版本 -->
        <gpg-maven-plugin.version>3.2.8</gpg-maven-plugin.version>
    </properties>

    <!-- 开发者信息 -->
    <developers>
        <developer>
            <id>yggdrasil-labs</id>
            <name>Yggdrasil Labs</name>
            <email>contact@yggdrasil-labs.com</email>
            <organization>Yggdrasil Labs</organization>
            <organizationUrl>https://yggdrasil-labs.com</organizationUrl>
        </developer>
    </developers>

    <!-- 许可证 -->
    <licenses>
        <license>
            <name>${project.license.name}</name>
            <url>${project.license.url}</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- SCM 信息 -->
    <scm>
        <connection>${project.scm.connection}</connection>
        <developerConnection>${project.scm.developerConnection}</developerConnection>
        <url>${project.scm.url}</url>
        <tag>HEAD</tag>
    </scm>

    <!-- 问题跟踪 -->
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Yggdrasil-Labs/mimir-boot/issues</url>
    </issueManagement>

    <!-- CI/CD -->
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/Yggdrasil-Labs/mimir-boot/actions</url>
    </ciManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten.plugin.version}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>oss</flattenMode>
                        <pomElements>
                            <dependencies>resolve</dependencies>
                            <dependencyManagement>resolve</dependencyManagement>
                        </pomElements>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- SonarQube Maven Plugin (代码质量分析) -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
                <!-- Central Publishing Maven Plugin (Maven Central 发布) -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
                <!-- GPG Maven Plugin (GPG 签名) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${gpg-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 在根模块声明一个"无源"的 Spotless，使 `spotless:*` 在根执行不报错 -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <includes>
                            <include>__NO_SOURCES__</include>
                        </includes>
                        <!-- 使用 Google AOSP 风格（完全符合阿里规范核心要求）
                             AOSP = Android Open Source Project
                             - 4 空格缩进（阿里规范）
                             - K&R 括号风格（阿里规范）
                             - 工具稳定、CI 友好
                        -->
                        <googleJavaFormat>
                            <version>1.22.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <!-- 在 compile 阶段自动格式化代码（仅 dev profile） -->
                    <execution>
                        <id>spotless-apply</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </execution>
                    <!-- 在 validate 阶段执行格式检查（CI 环境） -->
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Flatten Plugin (版本管理) - 确保所有模块都能正确替换 ${revision} -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <!-- SonarQube Maven Plugin (代码质量分析) - 使根模块也能识别 sonar 命令 -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
            </plugin>
            <!-- GPG Maven Plugin (GPG 签名) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <configuration>
                    <!-- 默认跳过签名，避免开发时每次构建都签名 -->
                    <skip>true</skip>
                    <!-- CI 环境必需：非交互模式，允许通过命令行传递 passphrase -->
                    <gpgArguments>
                        <arg>--batch</arg>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                    </gpgArguments>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <!-- 在 verify 阶段自动启用签名（deploy 会执行 verify 阶段，所以 deploy 时也会自动签名） -->
                            <!-- 如果不想在 verify 时签名，可以通过 -Dgpg.skip=true 来跳过 -->
                            <skip>false</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Maven Deploy Plugin - 跳过根聚合项目的部署 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Maven Central 发布：不设 activeByDefault，外部项目继承 parent 时默认不会发 Central，需显式 -P maven-central。
             本仓库发布命令见 mimir-boot-parent/README.md「发布到 Maven Central」。 -->
        <profile>
            <id>maven-central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- CI Profile: 用于 CI/CD 环境，跳过 GPG 签名等操作 -->
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <!-- CI 环境中跳过 GPG 签名（签名应在发布时进行） -->
                            <skip>true</skip>
                        </configuration>
                        <executions>
                            <!-- 覆盖默认的 sign-artifacts execution，确保在 CI 环境中跳过签名 -->
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <skip>true</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
