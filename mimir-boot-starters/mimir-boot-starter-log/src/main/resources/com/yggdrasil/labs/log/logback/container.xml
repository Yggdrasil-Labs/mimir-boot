<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mimir 容器日志预设：所有事件只写标准输出，不创建日志目录或文件
    选择方式：logging.config=classpath:com/yggdrasil/labs/log/logback/container.xml
-->
<configuration>
    <include resource="com/yggdrasil/labs/log/logback/common.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${MIMIR_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="access.log" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="SQL.JSON" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="SQL.SLOW" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
